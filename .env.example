# Copy to .env on the machine that runs the transcript service.
# Leave every secret blank to run LearnAble with sample captions,
# sample transcripts, and the browser's own voice.
# Never commit a filled-in .env. These names are server-only.
# Do not prefix them with VITE_.

# Hasab AI. One key covers speech-to-text, translation, and text-to-speech.
# Create an account at https://www.hasab.ai/register and generate a key
# in the developer dashboard. Docs: https://developer.hasab.ai/
HASAB_API_KEY=
HASAB_API_BASE=https://api.hasab.ai

# Hugging Face token for optional hosted models (read access is enough).
# Create one at https://huggingface.co/settings/tokens
# Used for Amharic speech recognition and image captions.
# Leave HF_MT_MODEL empty. NLLB-200 is CC-BY-NC-4.0, so it stays off
# unless you set the model id yourself.
HF_TOKEN=
HF_ASR_MODEL=waxal-benchmarking/whisper-small-waxal-amh
HF_MT_MODEL=
HF_CAPTION_MODEL=Salesforce/blip-image-captioning-base

# Optional public URL of the transcript service. Empty uses same-origin /api,
# which the Vite dev server proxies to http://127.0.0.1:5050.
# This value is visible in the browser. Do not put a key here.
VITE_API_BASE=
