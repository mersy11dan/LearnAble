# Backend Environment Configuration for LearnAble
# Copy this file to .env and fill in your credentials

# Supabase (Database & Storage)
# Get credentials from: https://supabase.com/dashboard
SUPABASE_URL=your_supabase_project_url
SUPABASE_KEY=your_supabase_anon_key

# Google Gemini AI
# Get API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key

# Hugging Face (for ASL models)
# Get token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token

# Ollama (Local LLM)
# Install: curl -fsSL https://ollama.com/install.sh | sh
# Start: ollama serve
# Pull model: ollama pull llava
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llava

# ASL Model Configuration
HF_ASL_MODEL=mamounyosef/sign-language-bridge
HF_GLOSS_MODEL=Suyash2205/signbridge-t5-base-asl-gloss
